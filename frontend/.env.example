# Backend API Base URL
# In local development: leave blank to use the local Vite development proxy (redirects /api to http://127.0.0.1:8000)
# In Vercel production: set to your deployed backend URL (e.g. https://conceptlens-api.onrender.com or https://api.yourdomain.com)
VITE_API_URL=

# Google OAuth 2.0 Web Client ID (Required on Vercel for "Continue with Google" button)
# NOTE FOR VERCEL: Vite only exposes environment variables starting with "VITE_".
# Therefore, on Vercel this variable MUST be named VITE_GOOGLE_CLIENT_ID (not GOOGLE_CLIENT_ID).
# In Google Cloud Console, add Authorized JavaScript Origins:
#   - http://localhost:5173
#   - https://your-conceptlens-deployment.vercel.app
VITE_GOOGLE_CLIENT_ID=

