# Backend API Base URL
# In local development: leave blank to use the local Vite development proxy (redirects /api to http://127.0.0.1:8000)
# In Vercel production: set to your deployed backend URL (e.g. https://conceptlens-api.onrender.com or https://api.yourdomain.com)
VITE_API_URL=

# Google OAuth 2.0 Web Client ID (leave empty if not configured)
# Create in Google Cloud Console -> APIs & Credentials -> OAuth client ID (Web Application)
# Authorized JavaScript origin: http://localhost:5173 and https://<your-project>.vercel.app
VITE_GOOGLE_CLIENT_ID=

