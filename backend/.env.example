# ==============================================================================
# ConceptLens Backend Environment Variables Example
# Duplicate this file to .env and supply your production or local values.
# ==============================================================================

# Server configuration
PORT=8000
ENVIRONMENT=development

# Frontend URL for production CORS (e.g. https://conceptlens.vercel.app)
FRONTEND_URL=

# Allowed origins for CORS and CSRF verification (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# JWT & Cookie Security
# Generate secret using: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth 2.0 Client ID (leave empty if not using Google login)
GOOGLE_CLIENT_ID=

# AI & LLM Cloud Providers (optional)
FLOWCHART_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Storage & Database paths
DATABASE_PATH=conceptlens.db
UPLOAD_DIR=uploads

# OCR Engine: rapidocr | tesseract | auto
OCR_ENGINE=rapidocr
TESSERACT_CMD=
TOP_CONCEPTS_LIMIT=0
USE_KEYBERT=false
