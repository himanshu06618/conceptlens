# ==============================================================================
# ConceptLens Backend Environment Variables Example
# Duplicate this file to .env and supply your production or local values.
# ==============================================================================

# Server configuration
PORT=8000
ENVIRONMENT=development

# Frontend URL for production CORS (e.g. https://conceptlens.vercel.app)
FRONTEND_URL=

# Allowed origins for CORS and CSRF verification (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# JWT & Cookie Security
# Generate secret using: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth 2.0 Web Client ID (Required on Render for Google Sign-In verification)
# Must match the Client ID created in Google Cloud Console (APIs & Credentials)
GOOGLE_CLIENT_ID=

# ==============================================================================
# Gemini AI Configuration (Primary Multimodal OCR & Concept Extraction)
# ==============================================================================
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Default recommended model: gemini-3.5-flash (supports PDF, images, scanned notes, structured JSON)
# Alternative supported models: gemini-3.7-flash
GEMINI_MODEL=gemini-3.5-flash

# Storage & Database paths
# For local SQLite dev: leave DATABASE_URL empty and use DATABASE_PATH
# For production persistence on Render (Neon / Supabase Postgres):
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_PATH=conceptlens.db
UPLOAD_DIR=uploads

# Guest Upload Limit (default: 5 free uploads before requiring signup)
GUEST_UPLOAD_LIMIT=5
