# ==============================================================================
# ConceptLens Environment Variables
# Copy to backend/.env for backend configuration.
# ==============================================================================

PORT=8000
ENVIRONMENT=development
FRONTEND_URL=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
JWT_SECRET=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=

# Gemini API (Primary Extraction & Vision Engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

DATABASE_PATH=conceptlens.db
UPLOAD_DIR=uploads
GUEST_UPLOAD_LIMIT=5
